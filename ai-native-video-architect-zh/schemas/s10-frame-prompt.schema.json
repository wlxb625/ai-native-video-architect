{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "S10 Full Frame Prompt Pack With Reference Image Contract",
  "type": "object",
  "required": ["stage_id", "task_id", "artifact_type", "content", "coverage"],
  "properties": {
    "stage_id": {"const": "S10"},
    "task_id": {"type": "string", "minLength": 1},
    "artifact_type": {"const": "FRAME_PROMPT_PACK"},
    "content": {
      "type": "object",
      "required": ["shot_count", "generated_cf_count", "text_contract_count", "shot_blocks", "package_rules"],
      "properties": {
        "shot_count": {"type": "integer", "minimum": 1},
        "generated_cf_count": {"type": "integer", "minimum": 1},
        "text_contract_count": {"type": "integer", "minimum": 0},
        "shot_blocks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/shotBlock"}},
        "package_rules": {
          "type": "object",
          "required": [
            "full_template_instantiated_per_shot",
            "standalone_prompt_per_generated_cf",
            "reference_manifest_per_generated_cf",
            "natural_language_reference_instruction",
            "reference_priority_explicit",
            "platform_binding_and_fallback_present",
            "no_id_only_reference",
            "planned_reference_not_misrepresented",
            "no_shared_visual_prefix_dependency",
            "no_compact_summary_substitution",
            "short_ids_do_not_reduce_content",
            "static_prompt_describes_one_moment_only"
          ],
          "properties": {
            "full_template_instantiated_per_shot": {"const": true},
            "standalone_prompt_per_generated_cf": {"const": true},
            "reference_manifest_per_generated_cf": {"const": true},
            "natural_language_reference_instruction": {"const": true},
            "reference_priority_explicit": {"const": true},
            "platform_binding_and_fallback_present": {"const": true},
            "no_id_only_reference": {"const": true},
            "planned_reference_not_misrepresented": {"const": true},
            "no_shared_visual_prefix_dependency": {"const": true},
            "no_compact_summary_substitution": {"const": true},
            "short_ids_do_not_reduce_content": {"const": true},
            "static_prompt_describes_one_moment_only": {"const": true}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "coverage": {
      "type": "object",
      "required": [
        "full_storyboard_frame_template_instantiated",
        "standalone_prompt_per_generated_cf",
        "reference_assets_and_roles",
        "image_reference_manifest_coverage",
        "image_reference_use_instruction_coverage",
        "reference_priority_coverage",
        "platform_reference_binding_coverage",
        "platform_reference_fallback_coverage",
        "no_id_only_reference",
        "planned_actual_reference_status_accuracy",
        "visual_thesis_and_tensions",
        "previous_and_next_handoff",
        "frame_source_and_generation_mode",
        "composition_background_and_frozen_motion",
        "performance_or_non_character_performance",
        "focus_depth_exposure",
        "per_frame_lighting",
        "end_frame_contract",
        "tail_generation_decision",
        "image_to_image_repair",
        "local_inpaint_repair",
        "video_action_summary",
        "continuity_anchors",
        "stable_fallback",
        "no_shared_prefix_dependency",
        "no_compact_summary_substitution"
      ],
      "properties": {
        "full_storyboard_frame_template_instantiated": {"const": true},
        "standalone_prompt_per_generated_cf": {"const": true},
        "reference_assets_and_roles": {"const": true},
        "image_reference_manifest_coverage": {"const": true},
        "image_reference_use_instruction_coverage": {"const": true},
        "reference_priority_coverage": {"const": true},
        "platform_reference_binding_coverage": {"const": true},
        "platform_reference_fallback_coverage": {"const": true},
        "no_id_only_reference": {"const": true},
        "planned_actual_reference_status_accuracy": {"const": true},
        "visual_thesis_and_tensions": {"const": true},
        "previous_and_next_handoff": {"const": true},
        "frame_source_and_generation_mode": {"const": true},
        "composition_background_and_frozen_motion": {"const": true},
        "performance_or_non_character_performance": {"const": true},
        "focus_depth_exposure": {"const": true},
        "per_frame_lighting": {"const": true},
        "end_frame_contract": {"const": true},
        "tail_generation_decision": {"const": true},
        "image_to_image_repair": {"const": true},
        "local_inpaint_repair": {"const": true},
        "video_action_summary": {"const": true},
        "continuity_anchors": {"const": true},
        "stable_fallback": {"const": true},
        "no_shared_prefix_dependency": {"const": true},
        "no_compact_summary_substitution": {"const": true}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
    "assetRole": {
      "type": "object",
      "required": ["asset_id", "role", "status"],
      "properties": {
        "asset_id": {"$ref": "#/$defs/nonempty"},
        "role": {"$ref": "#/$defs/nonempty"},
        "status": {"enum": ["PLANNED_REFERENCE", "ACTUAL_REFERENCE", "INHERITED_CF"]}
      },
      "additionalProperties": true
    },
    "referenceInput": {
      "type": "object",
      "required": [
        "upload_slot",
        "display_name",
        "internal_asset_id",
        "file_name",
        "status",
        "media_type",
        "role",
        "priority",
        "required_upload",
        "use_region_or_subject",
        "allowed_influence",
        "forbidden_influence",
        "platform_binding"
      ],
      "properties": {
        "upload_slot": {"$ref": "#/$defs/nonempty"},
        "display_name": {"$ref": "#/$defs/nonempty"},
        "internal_asset_id": {"$ref": "#/$defs/nonempty"},
        "file_name": {"$ref": "#/$defs/nonempty"},
        "status": {"enum": ["PLANNED_REFERENCE", "ACTUAL_REFERENCE", "INHERITED_CF", "USER_MEDIA"]},
        "media_type": {"enum": ["IDENTITY", "COSTUME", "POSE_INTERACTION", "LOCATION_LAYOUT", "PROP_STRUCTURE", "VISIBLE_STATE", "STYLE_LIGHT", "START_FRAME", "END_FRAME", "BRIDGE_FRAME", "PREVIOUS_TAIL", "USER_MEDIA"]},
        "role": {"$ref": "#/$defs/nonempty"},
        "priority": {"enum": ["HARD_LOCK", "HIGH", "MEDIUM", "LOW"]},
        "required_upload": {"type": "boolean"},
        "use_region_or_subject": {"$ref": "#/$defs/nonempty"},
        "allowed_influence": {"$ref": "#/$defs/nonempty"},
        "forbidden_influence": {"$ref": "#/$defs/nonempty"},
        "platform_binding": {"enum": ["IDENTITY_REFERENCE_SLOT", "IMAGE_PROMPT_SLOT", "STYLE_REFERENCE_SLOT", "START_FRAME_SLOT", "END_FRAME_SLOT", "MASKED_IMAGE_TO_IMAGE", "COMPOSITE_REFERENCE_BOARD", "NO_NATIVE_SUPPORT"]}
      },
      "additionalProperties": true
    },
    "controlFrame": {
      "type": "object",
      "required": [
        "cf_id",
        "belongs_to_shot",
        "type",
        "file_name",
        "reference_assets_and_roles",
        "reference_input_manifest",
        "reference_use_instruction",
        "reference_priority_order",
        "platform_reference_binding",
        "reference_fallback",
        "visible_state",
        "static_moment_and_frozen_motion",
        "positive_prompt",
        "negative_prompt",
        "output_rules",
        "positive_prompt_is_standalone",
        "references_are_explicitly_invoked",
        "id_only_reference_instruction",
        "shared_prefix_dependency",
        "prompt_coverage_assertions"
      ],
      "properties": {
        "cf_id": {"$ref": "#/$defs/nonempty"},
        "belongs_to_shot": {"$ref": "#/$defs/nonempty"},
        "type": {"enum": ["START", "END", "BRIDGE"]},
        "file_name": {"$ref": "#/$defs/nonempty"},
        "reference_assets_and_roles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/assetRole"}},
        "reference_input_manifest": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/referenceInput"}},
        "reference_use_instruction": {"type": "string", "minLength": 180, "pattern": ".*\\S.*"},
        "reference_priority_order": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonempty"}},
        "platform_reference_binding": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonempty"}},
        "reference_fallback": {"type": "string", "minLength": 100, "pattern": ".*\\S.*"},
        "visible_state": {"$ref": "#/$defs/nonempty"},
        "static_moment_and_frozen_motion": {"$ref": "#/$defs/nonempty"},
        "positive_prompt": {"type": "string", "minLength": 600, "pattern": ".*\\S.*"},
        "negative_prompt": {"type": "string", "minLength": 100, "pattern": ".*\\S.*"},
        "output_rules": {"type": "string", "minLength": 80, "pattern": ".*\\S.*"},
        "positive_prompt_is_standalone": {"const": true},
        "references_are_explicitly_invoked": {"const": true},
        "id_only_reference_instruction": {"const": false},
        "shared_prefix_dependency": {"const": false},
        "prompt_coverage_assertions": {
          "type": "object",
          "required": [
            "project_visual_baseline",
            "reference_roles",
            "reference_upload_slots",
            "reference_priority_and_conflict_resolution",
            "subject_and_visible_state",
            "visual_tensions",
            "background_and_layers",
            "composition_and_screen_direction",
            "performance_or_environment_rhythm",
            "focus_depth_exposure",
            "per_frame_lighting",
            "materials_and_realism",
            "continuity_and_forbidden_drift",
            "output_structure"
          ],
          "properties": {
            "project_visual_baseline": {"const": true},
            "reference_roles": {"const": true},
            "reference_upload_slots": {"const": true},
            "reference_priority_and_conflict_resolution": {"const": true},
            "subject_and_visible_state": {"const": true},
            "visual_tensions": {"const": true},
            "background_and_layers": {"const": true},
            "composition_and_screen_direction": {"const": true},
            "performance_or_environment_rhythm": {"const": true},
            "focus_depth_exposure": {"const": true},
            "per_frame_lighting": {"const": true},
            "materials_and_realism": {"const": true},
            "continuity_and_forbidden_drift": {"const": true},
            "output_structure": {"const": true}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "shotBlock": {
      "type": "object",
      "required": [
        "shot_id",
        "scene_id",
        "time_and_duration",
        "shot_unique_task",
        "visual_thesis_and_tensions",
        "visible_description",
        "frame_source_mode",
        "reference_assets_and_roles",
        "reference_input_manifest",
        "reference_use_instruction",
        "reference_priority_order",
        "platform_reference_binding",
        "platform_reference_fallback",
        "previous_shot_output",
        "next_shot_input",
        "generation_mode_and_reason",
        "composition_and_layers",
        "performance_timepoint_or_non_character_performance",
        "focus_depth_exposure",
        "per_shot_lighting",
        "control_frames",
        "end_frame_contract",
        "tail_generation_decision",
        "image_to_image_repair",
        "local_inpaint_repair",
        "video_action_summary",
        "continuity_anchors",
        "stable_fallback"
      ],
      "properties": {
        "shot_id": {"$ref": "#/$defs/nonempty"},
        "scene_id": {"$ref": "#/$defs/nonempty"},
        "time_and_duration": {"$ref": "#/$defs/nonempty"},
        "shot_unique_task": {"$ref": "#/$defs/nonempty"},
        "visible_description": {"$ref": "#/$defs/nonempty"},
        "frame_source_mode": {"enum": ["NEW_START_FRAME", "PREVIOUS_TAIL_INHERITANCE", "FIRST_LAST_FRAME", "EXISTING_USER_FRAME", "TEXT_TO_VIDEO", "POST_ONLY"]},
        "reference_assets_and_roles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/assetRole"}},
        "reference_input_manifest": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/referenceInput"}},
        "reference_use_instruction": {"type": "string", "minLength": 180, "pattern": ".*\\S.*"},
        "reference_priority_order": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonempty"}},
        "platform_reference_binding": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonempty"}},
        "platform_reference_fallback": {"type": "string", "minLength": 100, "pattern": ".*\\S.*"},
        "visual_thesis_and_tensions": {"type": "object", "required": ["strongest_visual_relation", "tension_sources", "abstract_to_visible"], "minProperties": 3, "additionalProperties": true},
        "previous_shot_output": {"type": "object", "required": ["source_shot_or_first_shot", "character_position_direction_gaze", "hands_and_action_completion", "props_position_direction_state", "scene_landmarks_and_screen_direction", "lighting_white_balance_exposure"], "minProperties": 6, "additionalProperties": true},
        "next_shot_input": {"type": "object", "required": ["target_shot_or_end_of_film", "must_inherit", "allowed_change", "forbidden_change"], "minProperties": 4, "additionalProperties": true},
        "generation_mode_and_reason": {"type": "object", "required": ["mode", "reason", "fallback"], "minProperties": 3, "additionalProperties": true},
        "composition_and_layers": {"type": "object", "required": ["aspect_ratio", "foreground", "midground", "background", "background_function", "background_large_shape", "near_mid_far_layers", "background_direction_and_movement", "background_local_climax", "background_relation_to_subject", "frozen_motion_trace", "subject_position", "composition_center_and_negative_space", "axis_and_screen_direction", "focal_length_camera_height_angle", "action_space"], "minProperties": 16, "additionalProperties": true},
        "performance_timepoint_or_non_character_performance": {"type": "object", "required": ["mode"], "minProperties": 7, "additionalProperties": true},
        "focus_depth_exposure": {"type": "object", "required": ["focus", "depth_of_field", "exposure", "white_balance", "highlight_protection", "shadow_detail"], "minProperties": 6, "additionalProperties": true},
        "per_shot_lighting": {"type": "object", "required": ["readability_goal_and_emotional_function", "must_read_areas", "main_light_real_source", "main_light_world_position", "relative_to_camera", "relative_to_subject_and_height", "softness", "color_temperature", "illuminated_areas", "shadow_areas_and_direction", "fill_practical_background_lights", "light_ratio", "continuity_with_previous", "forbidden_changes"], "minProperties": 14, "additionalProperties": true},
        "control_frames": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/controlFrame"}},
        "end_frame_contract": {"type": "object", "required": ["exact_time", "action_completion_percentage", "final_pose_direction_gaze_emotion", "final_left_hand", "final_right_hand", "final_props", "final_camera_and_composition", "final_focus_and_depth", "final_exposure_and_lighting", "allowed_residual_motion", "stable_hold", "next_shot_inheritance"], "minProperties": 12, "additionalProperties": true},
        "tail_generation_decision": {"type": "object", "required": ["mode", "pre_generate_tail", "cf_or_contract_id", "reason"], "minProperties": 4, "additionalProperties": true},
        "image_to_image_repair": {"type": "object", "required": ["preserve", "modify_or_repair_only", "target_result", "forbid_collateral_change"], "minProperties": 4, "additionalProperties": true},
        "local_inpaint_repair": {"type": "object", "required": ["preserve", "modify_or_repair_only", "target_result", "forbid_collateral_change"], "minProperties": 4, "additionalProperties": true},
        "video_action_summary": {"type": "object", "required": ["timeline_action", "camera", "endpoint"], "minProperties": 3, "additionalProperties": true},
        "continuity_anchors": {"type": "object", "required": ["identity", "costume_and_visible_state", "scene_layout", "prop_state", "light_world_position", "screen_direction", "material_and_color_progression", "previous_cf", "next_cf_or_end"], "minProperties": 9, "additionalProperties": true},
        "stable_fallback": {"type": "object", "required": ["primary_risk", "preferred_method", "implementation", "acceptance_boundary"], "minProperties": 4, "additionalProperties": true}
      },
      "additionalProperties": true
    }
  }
}
