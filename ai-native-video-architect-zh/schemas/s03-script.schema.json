{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "stage_id",
    "task_id",
    "concept_id",
    "title",
    "primary_path",
    "scenes",
    "climax_scene_id",
    "final_image",
    "must_protect",
    "climax_profile",
    "climax_audit",
    "uses_speculative_mechanism",
    "uses_twist",
    "contains_dialogue",
    "protagonist_age_audit",
    "character_profiles",
    "meaning_audit"
  ],
  "properties": {
    "stage_id": {
      "const": "S03"
    },
    "task_id": {
      "type": "string"
    },
    "concept_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "primary_path": {
      "enum": [
        "COMMERCIAL",
        "LITERARY",
        "EXPERIMENTAL",
        "HYBRID"
      ]
    },
    "scenes": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "scene_id",
          "heading",
          "characters",
          "observable_action",
          "sound",
          "exit_state"
        ],
        "properties": {
          "scene_id": {
            "type": "string"
          },
          "heading": {
            "type": "string"
          },
          "characters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "observable_action": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "dialogue": {
            "type": "array"
          },
          "sound": {
            "type": "array"
          },
          "exit_state": {
            "type": "string"
          }
        }
      }
    },
    "climax_scene_id": {
      "type": "string"
    },
    "final_image": {
      "type": "string"
    },
    "must_protect": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rendered_script_markdown": {
      "type": "string"
    },
    "climax_profile": {
      "enum": [
        "STRONG_DRAMATIC_PEAK",
        "QUIET_PEAK",
        "ANTI_CLIMAX",
        "SPECTACLE_PEAK"
      ]
    },
    "climax_audit": {
      "type": "object",
      "required": [
        "setup_scene_ids",
        "chooser",
        "actor",
        "value_a",
        "value_b",
        "pressure_source",
        "escalation_scene_ids",
        "failed_or_closed_alternatives",
        "point_of_no_return",
        "cost_paid_on_screen",
        "irreversible_external_or_relational_change",
        "audience_uncertainty",
        "result",
        "aftermath_state"
      ],
      "properties": {
        "setup_scene_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "chooser": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "value_a": {
          "type": "string",
          "minLength": 2
        },
        "value_b": {
          "type": "string",
          "minLength": 2
        },
        "pressure_source": {
          "type": "string",
          "minLength": 2
        },
        "escalation_scene_ids": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        },
        "failed_or_closed_alternatives": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "point_of_no_return": {
          "type": "string",
          "minLength": 2
        },
        "cost_paid_on_screen": {
          "type": "string",
          "minLength": 2
        },
        "irreversible_external_or_relational_change": {
          "type": "string",
          "minLength": 2
        },
        "audience_uncertainty": {
          "type": "string",
          "minLength": 2
        },
        "result": {
          "type": "string",
          "minLength": 2
        },
        "aftermath_state": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "uses_speculative_mechanism": {
      "type": "boolean"
    },
    "uses_twist": {
      "type": "boolean"
    },
    "contains_dialogue": {
      "type": "boolean"
    },
    "protagonist_age_audit": {
      "type": "object",
      "required": [
        "protagonist_name",
        "approximate_age",
        "age_band",
        "role_or_life_stage",
        "target_market_context",
        "youth_priority_applies",
        "decision",
        "why_this_age",
        "what_breaks_if_younger",
        "what_breaks_if_older",
        "required_experience_years",
        "plausible_experience_start_age",
        "age_continuity_source_concept_id",
        "audience_identification_strategy",
        "age_specific_dramatic_value",
        "age_continuity_source_stage"
      ],
      "properties": {
        "protagonist_name": {
          "type": "string",
          "minLength": 1
        },
        "approximate_age": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 120
        },
        "age_band": {
          "enum": [
            "CHILD",
            "TEEN",
            "YOUNG_ADULT",
            "MIDDLE_AGED",
            "OLDER_ADULT",
            "AGELESS_OR_NONHUMAN"
          ]
        },
        "role_or_life_stage": {
          "type": "string",
          "minLength": 2
        },
        "target_market_context": {
          "enum": [
            "SHORT_VIDEO",
            "WEB_FICTION",
            "FILM_OR_SERIES",
            "OTHER"
          ]
        },
        "youth_priority_applies": {
          "type": "boolean"
        },
        "decision": {
          "enum": [
            "YOUNG_SELECTED",
            "OLDER_SELECTED_FOR_STORY_FIT",
            "AGE_SPECIFIC_SELECTED",
            "AGE_NEUTRAL",
            "AGELESS_OR_NONHUMAN"
          ]
        },
        "why_this_age": {
          "type": "string",
          "minLength": 6
        },
        "what_breaks_if_younger": {
          "type": "string",
          "minLength": 4
        },
        "what_breaks_if_older": {
          "type": "string",
          "minLength": 4
        },
        "required_experience_years": {
          "type": "integer",
          "minimum": 0,
          "maximum": 80
        },
        "plausible_experience_start_age": {
          "type": "integer",
          "minimum": 3,
          "maximum": 80
        },
        "age_continuity_source_concept_id": {
          "type": "string",
          "minLength": 1
        },
        "audience_identification_strategy": {
          "type": "string",
          "minLength": 4
        },
        "age_specific_dramatic_value": {
          "type": "string",
          "minLength": 4
        },
        "age_continuity_source_stage": {
          "const": "S02"
        }
      },
      "additionalProperties": true
    },
    "character_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "approximate_age",
          "age_band",
          "role",
          "age_specific_behavior",
          "anti_stereotype_note"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "approximate_age": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 120
          },
          "age_band": {
            "enum": [
              "CHILD",
              "TEEN",
              "YOUNG_ADULT",
              "MIDDLE_AGED",
              "OLDER_ADULT",
              "AGELESS_OR_NONHUMAN"
            ]
          },
          "role": {
            "type": "string",
            "minLength": 2
          },
          "age_specific_behavior": {
            "type": "string",
            "minLength": 4
          },
          "anti_stereotype_note": {
            "type": "string",
            "minLength": 4
          }
        },
        "additionalProperties": true
      }
    },
    "meaning_audit": {
      "type": "object",
      "required": [
        "profile",
        "genre_basis",
        "source_concept_id"
      ],
      "properties": {
        "profile": {
          "enum": [
            "THEMATIC_MEANING_REQUIRED",
            "FORMAL_ABSURDIST_EXCEPTION"
          ]
        },
        "genre_basis": {
          "enum": [
            "STANDARD_NARRATIVE",
            "ABSTRACT",
            "ABSURDIST",
            "FORMAL_EXPERIMENT"
          ]
        },
        "human_question": {
          "type": "string"
        },
        "competing_value_a": {
          "type": "string"
        },
        "competing_value_b": {
          "type": "string"
        },
        "protagonist_initial_belief": {
          "type": "string"
        },
        "belief_pressure_or_change": {
          "type": "string"
        },
        "climax_thematic_answer": {
          "type": "string"
        },
        "ending_residue_or_question": {
          "type": "string"
        },
        "contemporary_relevance": {
          "type": "string"
        },
        "why_worth_telling": {
          "type": "string"
        },
        "generic_theme_risk": {
          "type": "string"
        },
        "formal_intent": {
          "type": "string"
        },
        "audience_experience": {
          "type": "string"
        },
        "pattern_logic": {
          "type": "string"
        },
        "formal_culmination": {
          "type": "string"
        },
        "anti_randomness_proof": {
          "type": "string"
        },
        "why_exception_applies": {
          "type": "string"
        },
        "source_concept_id": {
          "type": "string",
          "minLength": 1
        },
        "theme_setup_scene_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "theme_test_scene_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "climax_answer_scene_id": {
          "type": "string",
          "minLength": 1
        },
        "ending_residue_scene_id": {
          "type": "string",
          "minLength": 1
        },
        "pattern_setup_scene_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "pattern_development_scene_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "formal_culmination_scene_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "profile": {
                "const": "THEMATIC_MEANING_REQUIRED"
              }
            }
          },
          "then": {
            "required": [
              "profile",
              "genre_basis",
              "source_concept_id",
              "human_question",
              "competing_value_a",
              "competing_value_b",
              "protagonist_initial_belief",
              "belief_pressure_or_change",
              "climax_thematic_answer",
              "ending_residue_or_question",
              "contemporary_relevance",
              "why_worth_telling",
              "theme_setup_scene_ids",
              "theme_test_scene_ids",
              "climax_answer_scene_id",
              "ending_residue_scene_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "profile": {
                "const": "FORMAL_ABSURDIST_EXCEPTION"
              }
            }
          },
          "then": {
            "required": [
              "profile",
              "genre_basis",
              "source_concept_id",
              "formal_intent",
              "audience_experience",
              "pattern_logic",
              "formal_culmination",
              "anti_randomness_proof",
              "why_exception_applies",
              "pattern_setup_scene_ids",
              "pattern_development_scene_ids",
              "formal_culmination_scene_id"
            ]
          }
        }
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}